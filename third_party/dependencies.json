{
  "server": {
    "platform": "Ubuntu 22.04 or compatible",
    "apt": [
      "python3",
      "python3-h5py",
      "python3-numpy",
      "python3-requests",
      "ffmpeg",
      "python3-pil",
      "python3-venv",
      "ca-certificates"
    ],
    "python_venv": [
      "numpy==1.26.4",
      "h5py==3.16.0",
      "pillow==12.3.0",
      "pyarrow==25.0.1",
      "pandas==2.3.3",
      "python-dateutil==3.0.0",
      "pytz==2026.6",
      "six==1.17.0",
      "tzdata==2026.6"
    ],
    "offline_bundle": "third_party/offline/jammy/amd64/apt and python-wheels",
    "network_required_during_install": false
  },
  "collector": {
    "platform": "NVIDIA Jetson Orin, aarch64, Ubuntu 22.04",
    "apt": [
      "python3",
      "python3-h5py",
      "python3-numpy",
      "python3-opencv",
      "openssh-client",
      "sshpass",
      "lsof",
      "gstreamer1.0-tools",
      "gir1.2-gst-plugins-bad-1.0",
      "gstreamer1.0-plugins-bad",
      "gstreamer1.0-nice",
      "gstreamer1.0-plugins-good",
      "python3-gi",
      "python3-gst-1.0"
    ],
    "platform_prerequisites": [
      "NVIDIA JetPack with nvv4l2h264enc",
      "ROS 2 Humble at /opt/ros/humble",
      "librealsense driver and rs-enumerate-devices"
    ],
    "offline_bundle": "third_party/offline/jammy/arm64/apt",
    "optional_python": [
      "pyrealsense2 matching the installed librealsense driver; required for control-only direct camera preview"
    ]
  },
  "notice": "The make-packages.sh build downloads Ubuntu Jammy dependencies and includes them in deployment archives. JetPack, ROS 2 Humble, and librealsense are platform-specific base-system dependencies and must already be installed on the Orin."
}
